{
  "schema": "token-opt-policy/v2",
  "policy_version": "v2",
  "shop_title_prefix": {
    "7": "Hot Sale",
    "4": "In Stock"
  },
  "title_max_length": 120,
  "main_max_count": 6,
  "image_min_short_side": 800,
  "brand_mapping": {
    "transforming_toys": "200017853",
    "default": "200014695"
  },
  "watermark": {
    "social_account_signature": "KEEP",
    "manufacturer_branding": "KEEP",
    "product_print": "KEEP",
    "photographer_credit": "KEEP",
    "third_party_store_logo": "REMOVE_CANDIDATE",
    "marketing_text": "NEEDS_REVIEW",
    "unknown": "NEEDS_REVIEW",
    "official_marketing_text": "KEEP",
    "third_party_store_banner": "REMOVE_CANDIDATE",
    "chinese_promotion_poster": "NEEDS_REVIEW"
  },
  "sku_rules": {
    "preserve_all_unplanned_fields": true,
    "semantic_matching_requires_evidence": true
  },
  "forbidden_fields": [
    "weight",
    "price",
    "status"
  ],
  "preserve_identity_fields": [
    "logoCode",
    "modelCode"
  ],
  "removal_requires_human_review": true
}