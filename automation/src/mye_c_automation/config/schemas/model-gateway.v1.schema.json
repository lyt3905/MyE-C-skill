{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "base_url", "models", "max_output_tokens", "retries", "timeout"],
  "properties": {
    "schema": {"const": "model-gateway/v1"},
    "base_url": {"type": "string", "minLength": 1},
    "models": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_./:-]+$"}},
    "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 16384},
    "retries": {"type": "integer", "minimum": 0, "maximum": 2},
    "timeout": {"type": "integer", "minimum": 1, "maximum": 150},
    "reasoning_effort": {"enum": ["low", "medium", "high"]},
    "image_concurrency": {"type": "integer", "minimum": 1, "maximum": 10}
  }
}
