{
  "type": "object",
  "required": [
    "schema_version",
    "processing_status",
    "quality_status",
    "input_sha256",
    "output_sha256",
    "output_path",
    "mask_paths",
    "visualization_path",
    "watermark_instances_total",
    "watermark_instances_processed",
    "algorithm_used",
    "model_version",
    "processing_parameters",
    "execution_time",
    "failure_reason",
    "regions"
  ],
  "properties": {
    "schema_version": {
      "const": "watermark-processing.v1"
    },
    "processing_status": {
      "enum": [
        "NOT_APPLICABLE",
        "BLOCKED",
        "PROCESSED",
        "FAILED"
      ]
    },
    "quality_status": {
      "enum": [
        "PENDING_AI_REVIEW",
        "PASS",
        "REVIEW",
        "FAIL"
      ]
    },
    "mask_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "watermark_instances_total": {
      "type": "integer",
      "minimum": 0
    },
    "watermark_instances_processed": {
      "type": "integer",
      "minimum": 0
    },
    "execution_time": {
      "type": "number",
      "minimum": 0
    }
  }
}
