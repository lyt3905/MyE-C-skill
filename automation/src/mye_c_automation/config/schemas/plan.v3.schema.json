{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan.v3.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "token-opt-plan/v3"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "shop": {
      "type": "integer",
      "minimum": 1
    },
    "workflow_version": {
      "const": "token-opt-v2"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "precondition": {
      "type": "object",
      "properties": {
        "state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "account_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "main_count_preflight": {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "pattern": "^JOB_[A-Za-z0-9_]+$"
            },
            "main_count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "job_id",
            "main_count"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "state_sha256"
      ],
      "additionalProperties": false
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?!.*:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*[/\\\\]{2}).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "ai_judgement_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?!.*:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*[/\\\\]{2}).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "desired": {
      "type": "object",
      "properties": {
        "titleEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "images": {
          "type": "object",
          "properties": {
            "main": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "detail": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sku": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "ai": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "scene": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "gallery": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "attachList": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "brandId": {
          "type": "integer",
          "minimum": 0
        },
        "identityJson": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "post_actions": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "uploads": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?![/\\\\])(?!.*:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*[/\\\\]{2}).+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "pool": {
                    "enum": [
                      "main",
                      "detail",
                      "sku"
                    ]
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "pool",
                  "index"
                ],
                "additionalProperties": false
              }
            },
            "translate_title": {
              "type": "boolean"
            },
            "url_replacements": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "type": "string",
                "pattern": "^https?://[^/\\s]+(?:/[^\\s]*)?$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^https?://[^/\\s]+(?:/[^\\s]*)?$"
              }
            },
            "sku_row_assignments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "source_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https?://[^/\\s]+(?:/[^\\s]*)?$"
                  }
                },
                "required": [
                  "index",
                  "source_sha256",
                  "url"
                ],
                "additionalProperties": false
              }
            },
            "sku_assignments": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^https?://[^/\\s]+(?:/[^\\s]*)?$"
              }
            },
            "preserve_reference_urls": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "target_positions": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "pool": {
                    "enum": [
                      "main",
                      "detail",
                      "sku"
                    ]
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "pool",
                  "index"
                ],
                "additionalProperties": false
              }
            },
            "reviewed_detail_deletions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "index",
                  "url",
                  "sha256"
                ],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https?://"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        {
          "type": "array",
          "maxItems": 0
        }
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "const": "RESOLVED"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "automation": {
      "type": "object",
      "properties": {
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "actions": {
          "type": "array",
          "items": {
            "enum": [
              "BRAND_CODE",
              "CROP_BANNER",
              "DELETE_REDUNDANT",
              "ERASE_LOCAL",
              "REPLACE_LOCAL",
              "REPLACE_TWIN",
              "SKU_ASSIGN",
              "TITLE_REWRITE",
              "WEB_SEARCH",
              "BOX_NORMALIZE",
              "DELETE"
            ]
          }
        }
      },
      "required": [
        "policy_sha256",
        "actions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "job_id",
    "pid",
    "shop",
    "workflow_version",
    "policy_version",
    "precondition",
    "evidence_refs",
    "ai_judgement_refs",
    "desired",
    "post_actions",
    "review",
    "automation"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "post_actions": {
            "type": "object",
            "required": [
              "reviewed_detail_deletions"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "post_actions": {
            "maxProperties": 1
          },
          "automation": {
            "properties": {
              "actions": {
                "const": [
                  "DELETE"
                ]
              }
            }
          },
          "desired": {
            "required": [
              "images"
            ],
            "maxProperties": 1
          }
        }
      }
    }
  ]
}
