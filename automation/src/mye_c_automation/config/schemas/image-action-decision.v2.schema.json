{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "image-action-decision.v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "image-action-decision.v2"
    },
    "task_type": {
      "const": "image_action_decision"
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "image_id": {
      "type": "string",
      "minLength": 1
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "image_type": {
      "enum": [
        "MAIN",
        "DETAIL",
        "SKU"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "abstain": {
      "type": "boolean"
    },
    "decision": {
      "enum": [
        "AI_REGENERATE",
        "DELETE",
        "KEEP",
        "REMOVE_TEXT",
        "REVIEW"
      ]
    },
    "visual_class": {
      "enum": [
        "ACCESSORY",
        "INFO_GRAPHIC",
        "LIFESTYLE_OR_SCENE",
        "OTHER",
        "PART_OR_COMPONENT",
        "RETAIL_BOX_ONLY",
        "TOY_PRODUCT",
        "TOY_WITH_RETAIL_BOX",
        "UNKNOWN",
        "PRODUCT_MAIN",
        "PRODUCT_DETAIL",
        "PRODUCT_SCENE",
        "STORE_WATERMARK",
        "TEXT_WATERMARK",
        "DECORATED_COMPOSITE",
        "SIZE_CHART",
        "INFORMATION_IMAGE"
      ]
    },
    "retail_box_status": {
      "enum": [
        "PRESENT",
        "ABSENT",
        "UNCERTAIN"
      ]
    },
    "retail_box_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "box_relation": {
      "enum": [
        "SAME_PRODUCT",
        "POSSIBLY_SAME_PRODUCT",
        "UNRELATED"
      ]
    },
    "toy_present": {
      "type": "boolean"
    },
    "toy_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "subject_complete": {
      "type": "boolean"
    },
    "clear": {
      "type": "boolean"
    },
    "angle": {
      "type": "string",
      "minLength": 1
    },
    "background_complexity": {
      "enum": [
        "SMOOTH",
        "COMPLEX",
        "UNKNOWN"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "retail_box_bbox": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preserve_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "scope": {
            "enum": ["EXACT_REGION", "PRODUCT_FOREGROUND"]
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4
          },
          "polygon": {
            "type": "array",
            "minItems": 3,
            "maxItems": 128,
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "required": [
          "kind"
        ],
        "oneOf": [
          {
            "required": [
              "bbox"
            ]
          },
          {
            "required": [
              "polygon"
            ]
          }
        ]
      }
    },
    "watermarks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "CREATOR_CREDIT",
              "MANUFACTURER_LOGO",
              "PACKAGING_PRINT",
              "PRODUCT_PRINT",
              "PROMOTIONAL_TEXT",
              "STORE_WATERMARK",
              "UNKNOWN_TEXT",
              "MODEL_TEXT",
              "NORMAL_PHOTO_TEXT",
              "TEXT_WATERMARK"
            ]
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4
          },
          "polygon": {
            "type": "array",
            "minItems": 3,
            "maxItems": 128,
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "preserve_overlap_risk": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "ownership_visual_guess": {
            "type": "string"
          },
          "overlay_role": {
            "enum": ["OTHER_STORE_FRAME", "SELLER_NOTICE", "ADDED_WATERMARK", "UNRESOLVED_TEXT"]
          },
          "repair_mode": {
            "enum": ["BACKGROUND_GLYPHS", "REGION"]
          },
          "region_type": {
            "enum": [
              "BBOX",
              "POLYGON"
            ]
          },
          "owner": {
            "enum": [
              "OWN_STORE",
              "THIRD_PARTY_STORE",
              "MANUFACTURER",
              "PRODUCT",
              "PACKAGING",
              "CREATOR",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "kind",
          "confidence",
          "preserve_overlap_risk"
        ],
        "oneOf": [
          {
            "required": [
              "bbox"
            ]
          },
          {
            "required": [
              "polygon"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    "product_identity": {
      "type": "object",
      "properties": {
        "same_product_as_context": {
          "enum": [
            "YES",
            "NO",
            "UNKNOWN"
          ]
        },
        "model_visible": {
          "enum": [
            "YES",
            "NO",
            "UNKNOWN"
          ]
        },
        "structure_match": {
          "enum": [
            "YES",
            "NO",
            "UNKNOWN"
          ]
        },
        "color_match": {
          "enum": [
            "YES",
            "NO",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "same_product_as_context",
        "model_visible",
        "structure_match",
        "color_match"
      ],
      "additionalProperties": false
    },
    "sku_suitability": {
      "type": "object",
      "properties": {
        "is_toy_photo": {
          "type": "boolean"
        },
        "is_retail_box_photo": {
          "type": "boolean"
        },
        "recommended_group": {
          "enum": [
            "WITH_RETAIL_BOX",
            "WITHOUT_RETAIL_BOX",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "is_toy_photo",
        "is_retail_box_photo",
        "recommended_group"
      ],
      "additionalProperties": false
    },
    "field_confidences": {
      "type": "object",
      "properties": {
        "visual_class": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "product_identity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "box_relation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "watermark_ownership": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sku_suitability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "visual_class",
        "product_identity",
        "box_relation",
        "watermark_ownership",
        "sku_suitability"
      ],
      "additionalProperties": false
    },
    "retail_box_bbox_note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000,
      "description": "Optional observer annotation only; never used to override typed business fields."
    }
  },
  "required": [
    "schema_version",
    "task_type",
    "item_id",
    "image_id",
    "image_sha256",
    "image_type",
    "evidence_ids",
    "confidence",
    "abstain",
    "decision",
    "visual_class",
    "retail_box_status",
    "retail_box_confidence",
    "retail_box_bbox",
    "box_relation",
    "toy_present",
    "toy_confidence",
    "watermarks",
    "product_identity",
    "sku_suitability",
    "subject_complete",
    "clear",
    "angle",
    "background_complexity",
    "preserve_regions",
    "reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "retail_box_status": {
            "const": "PRESENT"
          }
        }
      },
      "then": {
        "properties": {
          "retail_box_bbox": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    }
  ]
}
