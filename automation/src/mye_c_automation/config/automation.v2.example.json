{
  "schema": "automation-policy/v1",
  "enabled": false,
  "mode": "auto_apply",
  "shop_allowlist": [
    7
  ],
  "pid_allowlist": [],
  "max_products_per_run": 1,
  "max_site_save_per_job": 1,
  "max_uploads_per_job": 12,
  "max_ai_requests_per_job": 100,
  "allow_actions": {
    "REPLACE_TWIN": true,
    "DELETE": true,
    "REMOVE_TEXT": true,
    "AI_REGENERATE": true,
    "SKU_ASSIGN": true,
    "TITLE_REWRITE": true
  },
  "title_rewrite": {
    "retries": 2,
    "retry_delay": 1
  },
  "preserve_product_status": true,
  "require_live_dry_run": true,
  "require_post_write_readback": true,
  "require_content_validation": true,
  "halt_batch_after_unknown_write": true,
  "stop_on_global_integrity_error": true,
  "trim_seven_main_before_audit": true
}
